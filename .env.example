# ─── Next.js ───────────────────────────────────────────
# Node environment
NODE_ENV=development

# Application port (default: 3000)
PORT=3000

# Hostname to bind to (default: 0.0.0.0)
HOSTNAME=0.0.0.0

# Disable Next.js telemetry (1 to disable)
NEXT_TELEMETRY_DISABLED=1

# Node.js runtime options (e.g., memory limit)
# NODE_OPTIONS=--max-old-space-size=6144

# ─── GitHub API ───────────────────────────────────────
# Generate one at: https://github.com/settings/tokens
GITHUB_TOKEN=

# ─── 站外资料（可选）────────────────────────────────
# `make resources` 从 GitHub 资料仓读取文件清单，站点本身不直连资料源，
# 因此这里不需要任何凭据。Alist / Gitee 的同步在各资料仓内自行完成。

# 资料仓所在 org（默认 HITSZ-OpenAuto）
RESOURCES_ORG=
# 本地调试：指向包含各资料仓本地克隆的目录，直接从本地 git 读清单
# RESOURCES_LOCAL_DIR=/path/to/repos

# ─── Vercel (optional, for preview deployments) ──────
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
# VERCEL_TOKEN=

# ─── Umami Analytics ─────────────────────────────────
# NEXT_PUBLIC_UMAMI_SRC=
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
