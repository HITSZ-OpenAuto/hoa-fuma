# ─── Next.js ───────────────────────────────────────────
# Node environment
NODE_ENV=development

# Application port (default: 3000)
PORT=3000

# Hostname to bind to (default: 0.0.0.0)
HOSTNAME=0.0.0.0

# Disable Next.js telemetry (1 to disable)
NEXT_TELEMETRY_DISABLED=1

# Node.js runtime options (e.g., memory limit)
# NODE_OPTIONS=--max-old-space-size=6144

# ─── GitHub API ───────────────────────────────────────
# Generate one at: https://github.com/settings/tokens
GITHUB_TOKEN=

# ─── 外部资料栈同步（可选）────────────────────────────
# 仅用于 `make resources` 把站外资料同步成站内清单与轻量文件镜像。
# 凭据只放在本地 .env / .env.local 或 CI Secret 中，切勿提交。
# E立方资料栈在校内网，需要在校园网或 VPN 环境同步。
ALIST_BASE_URL=http://10.249.44.116:5244
ALIST_USERNAME=
ALIST_PASSWORD=

# 单文件镜像上限（字节，默认 5 MiB），超过则只保留原站链接
RESOURCE_MIRROR_MAX_BYTES=5242880
# 单个来源镜像总量上限（字节，默认 64 MiB）
RESOURCE_MIRROR_TOTAL_BYTES=67108864

# ─── Vercel (optional, for preview deployments) ──────
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
# VERCEL_TOKEN=

# ─── Umami Analytics ─────────────────────────────────
# NEXT_PUBLIC_UMAMI_SRC=
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
